{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antojitos-cakes",
  "main": "build/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antojitos-cakes-db",
      "database_id": "0a078b2c-2130-46c5-b7ca-8fbba3b5ba40",
      "migrations_dir": "drizzle"
    }
  ]
}
